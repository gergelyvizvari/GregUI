{
  "name": "gregui-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @gregui/playground --",
    "build": "npm run build -w @gregui/tokens && npm run build -w @gregui/localization && npm run build -w @gregui/react && npm run build -w @gregui/playground && npm run build -w @gregui/consumer",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:styles": "node scripts/check-consumer-styles.mjs",
    "check": "npm run typecheck && npm run check:styles && npm test && npm run build",
    "build:packages": "npm run build -w @gregui/tokens && npm run build -w @gregui/localization && npm run build -w @gregui/react",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:package": "node scripts/package-smoke.mjs",
    "pretest:e2e": "npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
